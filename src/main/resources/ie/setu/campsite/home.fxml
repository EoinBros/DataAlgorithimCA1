<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.StackPane?>

<TabPane side="LEFT" rotateGraphic="true" tabMinHeight="100.0" tabMaxHeight="100.0"
         prefHeight="700.0" prefWidth="1000.0" tabClosingPolicy="UNAVAILABLE"
         xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <tabs>
        <Tab>
            <graphic>
                <Group>
                    <StackPane rotate="90.0">
                        <Label text="Campsites"/>
                    </StackPane>
                </Group>
            </graphic>
            <fx:include source="Campsite.fxml"/>
        </Tab>
        <Tab>
            <graphic>
                <Group>
                    <StackPane rotate="90.0">
                        <Label text="Areas"/>
                    </StackPane>
                </Group>
            </graphic>
            <fx:include source="Area.fxml"/>
        </Tab>
        <Tab>
            <graphic>
                <Group>
                    <StackPane rotate="90.0">
                        <Label text="Plots"/>
                    </StackPane>
                </Group>
            </graphic>
            <fx:include source="Plot.fxml"/>
        </Tab>
        <Tab>
            <graphic>
                <Group>
                    <StackPane rotate="90.0">
                        <Label text="Guests"/>
                    </StackPane>
                </Group>
            </graphic>
            <fx:include source="Guest.fxml"/>
        </Tab>
        <Tab>
            <graphic>
                <Group>
                    <StackPane rotate="90.0">
                        <Label text="Bookings"/>
                    </StackPane>
                </Group>
            </graphic>
            <fx:include source="Booking.fxml"/>
        </Tab>
        <Tab>
            <graphic>
                <Group>
                    <StackPane rotate="90.0">
                        <Label text="View"/>
                    </StackPane>
                </Group>
            </graphic>
            <fx:include source="View.fxml"/>
        </Tab>
        <Tab>
            <graphic>
                <Group>
                    <StackPane rotate="90.0">
                        <Label text="Smart Find"/>
                    </StackPane>
                </Group>
            </graphic>
            <fx:include source="SmartFind.fxml"/>
        </Tab>
    </tabs>
</TabPane>
